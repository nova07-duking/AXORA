APP_NAME=AXORA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données ---
# PostgreSQL ; garder DB_URL vide si les champs ci-dessous sont utilisés.
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=axora
DB_USERNAME=axora
DB_PASSWORD=
DB_SSLMODE=prefer

# --- Sanctum / CORS ---
# Domaines autorisés à s'authentifier (front React en local)
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

OPENAI_API_KEY=

OPENAI_MODEL=

APP_LOCALE=fr
